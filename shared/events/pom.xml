<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.railway.platform</groupId>
    <artifactId>railway-timetable-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>events</artifactId>
  <packaging>jar</packaging>
  <name>Railway Platform — Events (Avro Schemas)</name>
  <description>
    Avro schemas defining the platform event contracts and generated Java POJOs.
    Every service that produces or consumes events depends on this module.
    Schema evolution follows the BACKWARD compatibility rule (see ADR-004).
  </description>

  <dependencies>
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Generate Java POJOs from Avro schemas during generate-sources phase. -->
      <plugin>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro-maven-plugin</artifactId>
        <version>${avro.version}</version>
        <executions>
          <execution>
            <id>generate-avro-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>schema</goal>
            </goals>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
              <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
              <stringType>String</stringType>
              <!-- Generate specific field types where annotated. -->
              <enableDecimalLogicalType>true</enableDecimalLogicalType>
              <createSetters>false</createSetters>
              <!-- Generate Java records (requires Avro 1.12). -->
              <gettersReturnOptional>false</gettersReturnOptional>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
