        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, command) (rate(timetable_command_handler_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{command}}",
          "refId": "A"
        }
      ],
      "title": "Command Handler p99 Latency by Type",
      "type": "timeseries"
    },
    {
